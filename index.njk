<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dr. Natacha Moorooven</title>
    <link rel="stylesheet" href="/natacha-moorooven/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Lato:wght@300;400;600&family=Noto+Sans+KR:wght@300;400;600&display=swap" rel="stylesheet">
</head>

<body class="lang-en">

<header id="site-header" class="scrolled">
    <nav class="navbar">
        <a href="/natacha-moorooven/" class="nav-logo">
            <img class="logo logo-color" src="/natacha-moorooven/images/logo-color.png" alt="Dr. Natacha Moorooven">
            <img class="logo logo-navy" src="/natacha-moorooven/images/logo-navy.png" alt="Dr. Natacha Moorooven">
        </a>

        <ul class="nav-links" id="nav-links">
            <li class="nav-dropdown">
                <a href="#" class="dropdown-toggle">
                    <span data-lang="en">About ▾</span>
                    <span data-lang="fr">À Propos ▾</span>
                    <span data-lang="ko">소개 ▾</span>
                </a>
                <ul class="dropdown-menu">
                    <li><a href="/natacha-moorooven/about"><span data-lang="en">About the Author</span><span data-lang="fr">À Propos de l'Auteure</span><span data-lang="ko">저자 소개</span></a></li>
                    <li><a href="/natacha-moorooven/book"><span data-lang="en">About the Book</span><span data-lang="fr">À Propos du Livre</span><span data-lang="ko">책 소개</span></a></li>
                </ul>
            </li>
            <li><a href="/natacha-moorooven/purchase"><span data-lang="en">Purchase</span><span data-lang="fr">Acheter</span><span data-lang="ko">구매</span></a></li>
            <li><a href="/natacha-moorooven/audio"><span data-lang="en">Audio</span><span data-lang="fr">Audio</span><span data-lang="ko">오디오북</span></a></li>
            <li><a href="/natacha-moorooven/about#contact"><span data-lang="en">Contact</span><span data-lang="fr">Contact</span><span data-lang="ko">연락처</span></a></li>
        </ul>

        <div class="lang-switcher">
            <button class="lang-btn" onclick="setLang('en', this)">EN</button>
            <span class="lang-sep">|</span>
            <button class="lang-btn" onclick="setLang('fr', this)">FR</button>
            <span class="lang-sep">|</span>
            <button class="lang-btn" onclick="setLang('ko', this)">KO</button>
        </div>

        <button class="mobile-menu-btn" onclick="toggleMenu()" aria-label="Menu">
            <span></span><span></span><span></span>
        </button>
    </nav>
</header>


<section id="hero">
    <div class="hero-inner">
        <div class="hero-book-wrap">
            <img src="/natacha-moorooven/images/book-cover.png"
                 alt="Un Ruisseau Dans le Désert — Dr. Natacha Moorooven"
                 class="hero-book-img"
                 onerror="this.style.display='none';document.getElementById('book-ph-hero').style.display='flex'">
            <div class="book-placeholder" id="book-ph-hero">
                <span>{{ site.hero_title }}</span>
                <small>Dr. Natacha Moorooven</small>
            </div>
        </div>

        <div class="hero-text">
            <h1 class="hero-title">{{ site.hero_title }}</h1>

            <div class="hero-editions">
                <span class="hero-edition-tag available">🇫🇷 Français</span>
                <span class="hero-edition-tag soon" data-lang="en">🇬🇧 English — Coming Soon</span>
                <span class="hero-edition-tag soon" data-lang="fr">🇬🇧 English — Bientôt</span>
                <span class="hero-edition-tag soon" data-lang="ko">🇬🇧 English — 출시 예정</span>
                <span class="hero-edition-tag soon" data-lang="en">🇰🇷 한국어 — Coming Soon</span>
                <span class="hero-edition-tag soon" data-lang="fr">🇰🇷 한국어 — Bientôt</span>
                <span class="hero-edition-tag soon" data-lang="ko">🇰🇷 한국어 — 출시 예정</span>
            </div>

            <p class="hero-title-deco">{{ site.hero_title }}</p>

            <p class="hero-byline">
                <span data-lang="en">by Dr. Natacha Moorooven</span>
                <span data-lang="fr">par Dr. Natacha Moorooven</span>
                <span data-lang="ko">나타샤 무루벤 박사 저</span>
            </p>

            <p class="hero-desc" data-lang="en">{{ site.hero_desc_en }}</p>
            <p class="hero-desc" data-lang="fr">{{ site.hero_desc_fr }}</p>
            <p class="hero-desc" data-lang="ko">{{ site.hero_desc_ko }}</p>

            <div class="hero-cta">
                <a href="/natacha-moorooven/book" class="btn-cta" data-lang="en">Get Your Copy</a>
                <a href="/natacha-moorooven/book" class="btn-cta" data-lang="fr">Obtenir votre exemplaire</a>
                <a href="/natacha-moorooven/book" class="btn-cta" data-lang="ko">구매하기</a>
            </div>
        </div>
    </div>

    <div class="wave-bottom">
        <svg viewBox="0 0 1440 70" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
            <rect width="1440" height="70" fill="#1e3a5f"/>
            <path d="M0,35 Q360,70 720,35 Q1080,0 1440,35 L1440,70 L0,70 Z" fill="#fcf6e8"/>
        </svg>
    </div>
</section>


<footer>
    <div class="footer-inner">
        <img class="footer-logo" src="/natacha-moorooven/images/logo-navy.png" alt="Dr. Natacha Moorooven">
        <p class="footer-name">Dr. Natacha Moorooven</p>
        <p class="footer-copy" data-lang="en">© {{ site.footer_year }} Dr. Natacha Moorooven. All rights reserved.</p>
        <p class="footer-copy" data-lang="fr">© {{ site.footer_year }} Dr. Natacha Moorooven. Tous droits réservés.</p>
        <p class="footer-copy" data-lang="ko">© {{ site.footer_year }} 나타샤 무루벤 박사. 모든 권리 보유.</p>
    </div>
</footer>


<script>
    function setLang(lang, btn) {
        document.body.className = 'lang-' + lang;
        document.documentElement.lang = lang;
        document.querySelectorAll('.lang-btn').forEach(function(b) { b.classList.remove('active'); });
        if (btn) btn.classList.add('active');
        try { localStorage.setItem('natacha-lang', lang); } catch(e) {}
    }
    (function() {
        var saved = 'en';
        try { saved = localStorage.getItem('natacha-lang') || 'en'; } catch(e) {}
        var btn = document.querySelector('.lang-btn[onclick*="\'' + saved + '\'"]');
        setLang(saved, btn);
    })();
    function toggleMenu() { document.getElementById('nav-links').classList.toggle('open'); }
    window.addEventListener('scroll', function() {
        document.getElementById('site-header').classList.add('scrolled');
    });
    document.querySelectorAll('.dropdown-toggle').forEach(function(t) {
        t.addEventListener('click', function(e) {
            e.preventDefault();
            this.closest('.nav-dropdown').classList.toggle('open');
        });
    });
    document.addEventListener('click', function(e) {
        if (!e.target.closest('.nav-dropdown')) {
            document.querySelectorAll('.nav-dropdown').forEach(function(d) { d.classList.remove('open'); });
        }
    });
</script>

</body>
</html>
